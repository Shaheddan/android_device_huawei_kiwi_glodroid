# kiwi: build the QSEECOM probe into qcom_scm (route A, fingerprint).
# At boot qcom_scm asks TrustZone for its QSEECOM version and logs
# "qseecom: found qseecom with version 0x..." only if TrustZone answers;
# the machine allowlist stops it right after, so nothing else runs.
# Remove with: kiwi_qseecom_probe_patch.py --revert
CONFIG_QCOM_QSEECOM=y

# kiwi: fingerprint (route A). Modules, not built-in: GloDroid installs
# what the kernel's install step produces, and ueventd loads kiwi_fpc1020
# by modalias when the SPI sensor appears. init loads kiwi_qseecom, which
# has no hardware of its own to announce it.
CONFIG_KIWI_QSEECOM=m
CONFIG_KIWI_FPC1020=m
